{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    // Off because tauri-specta's generated bindings.ts emits unused helper globals,
    // and our compile-time drift-guard type aliases (contract.ts) read as "unused".
    // All other strictness (strict: true, null checks, etc.) stays on; the drift
    // guard still hard-errors via type-constraint checks on real mismatches.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
