{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "compose-spike",
  "version": "0.1.0",
  "identifier": "systems.halcyonic.compose-spike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "bert-compose · canvas spike",
        "width": 1180,
        "height": 880,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
